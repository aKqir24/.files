#!/usr/bin/env bash

# Display Resolution and Cursor setup
RESOLUTION_REFRESH="1152x864_60.00"
CURRENT_DISPLAY="$(xrandr --query | grep "connected primary" | cut -d " " -f1)"
if [ -n "$CURRENT_DISPLAY" ]; then
	xrandr --newmode "${RESOLUTION_REFRESH}"   81.75  1152 1216 1336 1520  864 867 871 897 -hsync +vsync 2>/dev/null || true
	xrandr --addmode ${CURRENT_DISPLAY} "${RESOLUTION_REFRESH}" 2>/dev/null || true
	xrandr --output ${CURRENT_DISPLAY} --mode "${RESOLUTION_REFRESH}" 2>/dev/null || true
fi
xsetroot -cursor_name left_ptr

# Get matugen colors from wallpapers
WALLPAPER="$(find "$HOME/Pictures/Wallpapers" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" \) 2>/dev/null | shuf -n 1)"
if [ -n "$WALLPAPER" ]; then
	matugen --continue-on-error image "$WALLPAPER" --source-color-index 1
	sleep 1 && xwallpaper --zoom "$WALLPAPER" &
fi

# Audio and Mic
/usr/bin/pipewire &
/usr/bin/wireplumber &
/usr/bin/pipewire-pulse &

# Transfer Devices And Partitions
/usr/libexec/gvfsd &
/usr/libexec/gvfs-mtp-volume-monitor &
/usr/libexec/gvfs-udisks2-volume-monitor &

# Applications
dbus-run-session /usr/libexec/power-profiles-daemon &
dbus-run-session pcmanfm --daemon-mode &
syncthing --no-browser &
alacritty --daemon &

fetch_logo_file = "~/.cache/fetch_logo.txt"
[[ -f "${fetch_logo_file}" ]] || touch "${fetch_logo_file}"

chafa --view-size=56x14 --stretch --symbols block --dither ordered "${WALLPAPER}" > "${fetch_logo_file}"
normal_colors_format="\e[1;31m \e[1;32m \e[1;33m \e[1;34m \e[1;35m \e[1;36m \e[1;37m\e[0m"
light_colors_format="\e[1;91m \e[1;92m \e[1;93m \e[1;94m \e[1;95m \e[1;96m \e[1;97m\e[1;34m\e[0m"

echo -e "\n   \e[42m\e[30m NORMAL \e[0m ${normal_colors_format}         \e[42m\e[30m LIGHT \e[0m ${light_colors_format}\e[0m" >> "${fetch_logo_file}" 
