/**
 * MD3 Rofi Wifi Theme - No Search Input (Matched with run.rasi style)
 * Colors from Matugen
 **/

@import "theme.rasi"

window {
    background-color:            @bg-card;
    border:                      1px solid;
    border-color:                @border;
    border-radius:               0px;
    padding:                     8px;
    width:                       338px;
    location:                    north;
    anchor:                      north;
    y-offset:                    42px;
	x-offset:					 188px;
}

mainbox {
    background-color:            transparent;
    children:                    [ "listview" ];
}

listview {
    lines:                       8;
    fixed-height:                false;
    spacing:                     4px;
    padding:                     8px 8px 8px 0px;
    margin:                      0px;
    border-radius:               4px;
    background-color:            @bg;
}

element {
    spacing:                     10px;
    padding:                     6px 0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @fg;
}

element selected.normal {
    background-color:            @bg-hover;
    text-color:                  @accent;
    border-color:                @accent;
    border:                      0px 0px 0px 4px;
    border-radius:               0px 4px 4px 0px;
}

element-text {
    expand:                      true;
    background-color:            transparent;
    text-color:                  inherit;
    font:                        @font-small;
    highlight:                   none;
    padding:                     0px;
    vertical-align:              0.5;
}
