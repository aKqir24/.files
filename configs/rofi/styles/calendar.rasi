/**
 * MD3 Rofi Calendar Theme (Compact)
 * Colors from Matugen
 **/

@import "colors.rasi"
@import "font.rasi"
@import "theme.rasi"

window {
    background-color:            @bg-card;
    border:                      1px solid;
    border-color:                @border;
    border-radius:               0px;
    padding:                     8px;
    width:                       328px;
    location:                    north;
    anchor:                      north;
    y-offset:                    42px;
	x-offset:				     336px;
}

mainbox {
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

message {
    spacing:                     4px;
    padding:                     6px 8px;
    margin:                      0 0 6px 0;
    border-radius:               4px;
    font:                        @font-default;
    background-color:            @bg-surface;
    border:                      1px 1px 3px 1px;
    border-color:                @border;
    text-color:                  @accent;
    horizontal-align:            0.5;
}

textbox {
    font:                        @font-small;
    text-color:                  @accent;
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

listview {
    lines:                       7;
    columns:                     7;
    fixed-columns:               true;
    fixed-height:                false;
	fixed-width:				 false;
    spacing:                     2px;
    padding:                     8px;
    border-radius:               4px;
    background-color:            var(surface-container-low);
}

element selected.normal {
    background-color:            @bg-hover;
    text-color:                  @accent;
    border-color:                @accent;
    border:                      0px;
    border-radius:               3px;
}

element-text {
    expand:                      true;
    background-color:           transparent;
    text-color:                  inherit;
    font:                        @font-small;
   	margin:						 4px 0px 4px -10px;
	border-radius:               3px;
}
