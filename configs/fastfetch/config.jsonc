{
	"logo": {
		"width": 50,
		"height": 10,
		"source": "~/.cache/fetch_logo.txt",
		"type": "file",
		"position": "left",
		"color": {"1": "green", "2": "yellow"},
		"padding": {
			"top": 1,
			"right": 0,
			"left": 2
		}
    },
    "display": {
        "separator": " ",
        "color": {
			"separator": "blue",
            "keys": "green",
			"width": 0
        },
		"key": {
            "width": 19,
			"paddingLeft": 0
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "GB"
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
		"break",
		{
            "key": "   {#32}{#42}{#30}  {#}{#7}{#92} USER  {#}{#40}{#92}{#}{#keys}",
            "type": "title",
            "format": "{#7}  {user-name}  {#} "
		},
		{
			"key": "┌──────────────┐",
			"type": "custom"
		},
		{
		    "key": "│  {#32}󰇅  {#92}HNAME    {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
			"type": "kernel",
			"key": "│  {#32}  {#92}KERNEL   {#keys}│"
        },
		{
			"type": "os",
			"key": "│  {#32}  {#92}DISTRO   {#keys}│"
		},
		{
			"type": "cpu",
			"showPeCoreCount": true,
			"key": "│  {#32}  {#92}CPU      {#keys}│"
		},
		{
			"type": "disk",
			"key": "│  {#32}  {#92}DISK     {#keys}│"
		},
		{
			"type": "display",
			"key": "│  {#32}  {#92}DISPLAY  {#keys}│"
		},
		{
			"type": "uptime",
			"key": "│  {#32}  {#92}UPTIME   {#keys}│"
		},
		{
			"type": "packages",
			"key": "│  {#32}  {#92}PACKS    {#keys}│"
		},
		{
			"type": "terminal",
			"key": "│  {#32}  {#92}TERM     {#keys}│"
		},
		{
            "key": "└──────────────┘",
            "type": "custom"
        },
		"break"
    ]
}
