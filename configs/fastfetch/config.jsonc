{
	"logo": {
		"width": 50,
		"height": 10,
		"source": "~/.cache/fetch_logo.txt",
		"type": "file",
		"position": "top",
		"color": {"1": "green", "2": "yellow"},
		"padding": {
			"top": 1,
			"right": 0,
			"left": 2
		}
    },
    "display": {
        "separator": " ",
        "color": {
			"separator": "blue",
            "keys": "green",
			"width": 0
        },
		"key": {
            "width": 20,
			"paddingLeft": 3
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "GB"
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
		"break",
		{
	      "type": "custom",
		  "key": "            {#31} {#32} {#33} {#34} {#35} {#36} {#37} {#91} {#92} {#93} {#94} {#95} {#96} {#97}{#}"
	    },
		"break",
		{
            "type": "title",
            "format": "  {#32}{#42}{#30}  {#}{#7}{#92} {user-name} {#} "
		},
		{
			"key": "├─────────────┐",
			"type": "custom"
		},
		{
		    "key": "├─ {#32}󰇅  {#92}HNAME   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
			"type": "kernel",
			"key": "├─ {#32}  {#92}KERNEL  {#keys}│"
        },
		{
			"type": "os",
			"key": "├─ {#32}  {#92}DISTRO  {#keys}│"
		},
		{
			"type": "cpu",
			"showPeCoreCount": true,
			"key": "├─ {#32}  {#92}CPU     {#keys}│"
		},
		{
			"type": "disk",
			"key": "├─ {#32}  {#92}DISK    {#keys}│"
		},
		{
			"type": "display",
			"key": "├─ {#32}  {#92}DISPLAY {#keys}│"
		},
		{
			"type": "uptime",
			"key": "├─ {#32}  {#92}UPTIME  {#keys}│"
		},
		{
			"type": "packages",
			"key": "├─ {#32}  {#92}PACKS   {#keys}│"
		},
		{
			"type": "terminal",
			"key": "└─ {#32}  {#92}TERM    {#keys}│"
		},
		{
            "key": "              └───────────────────────────────────────┘",
            "type": "custom"
        },
		"break"
    ]
}
